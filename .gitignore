# ── 构建产物 ─────────────────────────────────────────
.gradle/
build/
app/build/
.kotlin/
.cxx/
captures/

# ── 本机路径（各人 SDK 位置不同）────────────────────
local.properties

# ── 签名密钥：绝对不要提交 ───────────────────────────
# 丢了就再也发不出同一个应用的更新；泄漏了别人能冒名签你的包
keystore/
keystore.properties
*.jks
*.keystore
*.p12
*.pepk

# ── 隐私数据：绝不提交 ───────────────────────────────
# 本机测试素材（真实数据）。是什么、叫什么，都不写进仓库。
# ExternalBackupRealFileTest 会引用其中的备份，文件不存在时
# assumeTrue 跳过，所以别人 clone 走也能跑。
测试文件/

# ── 参考资料（非项目源码）────────────────────────────
deepseek界面参考/

# ── IDE / 系统 ──────────────────────────────────────
.idea/
.vscode/
*.iml
*.hprof
.DS_Store
Thumbs.db

# ── 打包产物 ────────────────────────────────────────
*.apk
*.aab
*.ap_
*.dex

# ── 日志 ────────────────────────────────────────────
*.log

# ── 大图源文件（构建不依赖，只是原始素材）────────────
ICON.png

# ── 策划/设计文档：内部资料，只留本机，不随仓库公开 ────
docs/
