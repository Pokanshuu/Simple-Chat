<?xml version="1.0" encoding="utf-8"?>
<!--
  服务商（上游）自报错误 → 用户看得懂、知道下一步做什么的一句话。

  单独成文件、不塞进 values/strings.xml：Android 会把 values*/ 下所有 xml 里的
  <string> 合并成同一份资源表，按 key 取用，所以新增文案不必动老文件。
  英文在 values-en/strings_provider.xml，**键名必须一一对应**。

  使用方：net/NetworkErrors.kt
  - error_provider_*：providerHintRes() 按关键字命中的提示句；
  - error_provider_raw：保留服务端原文的括号模板（%1$s = 原文，过长由代码截断并加省略号）；
  - error_provider_separator：多段提示之间的连接符。
-->
<resources>
    <!-- 上游没有给这个模型分配可用通道（OpenCode Zen / 自建中转常见） -->
    <string name="error_provider_no_channel">该服务商当前没有这个模型的可用通道，请换一个模型、换用官方接口，或稍后重试</string>

    <!-- 鉴权失败：Key 无效 / 被禁用 / 账号被风控（如 `Authentication Fails (governor)`） -->
    <string name="error_provider_auth">服务商鉴权失败：API Key 无效、被禁用，或账号被风控限制；请检查 Key，或用设置里的测试连接确认</string>

    <!-- 额度 / 余额不足（insufficient_quota、insufficient balance） -->
    <string name="error_provider_quota">账号额度不足，请充值或更换 Key</string>

    <!-- 限流（rate limit、too many requests、HTTP 429） -->
    <string name="error_provider_rate_limit">请求太频繁，请稍后再试</string>

    <!-- 模型名不对 / 上游没有这个模型 -->
    <string name="error_provider_model_not_found">服务商没有这个模型，请换模型或核对 Base URL</string>

    <!-- 上下文超限（context length / maximum context / context window） -->
    <string name="error_provider_empty_messages">服务商未识别到对话消息。若重试仍失败，可在 API 设置中切换兼容端口后重试</string>
    <string name="error_provider_context_length">本轮内容超出模型上下文上限，请压缩上下文或减少附件</string>
    <string name="error_provider_content_risk">服务商审核了本次输入，未指出具体内容。可保留文字对话，跳过本轮及历史附件和工具后重试。若仍被拒绝，可凭请求编号联系服务商。</string>

    <!-- 诊断信息：原文放在全角括号里，跟在提示句后面；%1$s 由代码截断到 300 字符 -->
    <string name="error_provider_raw">（服务端原文：%1$s）</string>

    <!-- 提示句之间的连接符：中文用全角冒号；英文用半角冒号 + 空格（见 values-en） -->
    <string name="error_provider_separator">：</string>
    <string name="error_deepseek_file_model">这条会话含有仅保存在 Files API 的附件。切到 DeepSeek V4.1 Flash 后重试，或新建 Pro 对话并粘贴文件正文。</string>
    <string name="error_deepseek_flash_feature">Pro 支持文本对话。要使用内置联网、读链接或服务端标题，请在模型菜单选择 DeepSeek V4.1 Flash 后重试。</string>
    <string name="deepseek_pro_search_hint">Pro 联网需在此配置中启用独立搜索 API。使用内置搜索和读链接可切换到 Flash。</string>
    <string name="error_parameter_detail">服务商拒绝了请求（HTTP %1$d）。%2$s</string>
    <string name="pro_top_p_hint">Pro 的思考模式由服务端固定采样范围</string>
    <string name="error_choose_model">选择模型</string>
    <string name="error_retry_without_attachments_tools">跳过附件和工具重试</string>
    <string name="error_large_send_before_reply">长请求在收到服务端响应头前断开，无法确认服务端是否已处理。可以手动重试；若同一会话反复中断，点输入栏的上下文圆环压缩后再试。</string>
    <string name="error_large_stream_before_reply">服务端已响应，但在返回回复内容前连接中断。可以手动重试；若长会话反复中断，点输入栏的上下文圆环压缩后再试。</string>
    <string name="retry_skipped_notice">本次只发送文字上下文，已跳过附件和工具。原记录已保留。</string>
    <string name="tool_request_skipped_continue">搜索工具暂不可用，本轮已跳过并继续文字对话。</string>
    <string name="attachments_skipped_unsupported">当前模型无法读取 %1$d 个旧附件，本轮已跳过；文字对话继续。</string>
    <string name="prompt_attachments_skipped">本轮有附件因当前模型能力限制而跳过。请基于可用的文字上下文继续。</string>
    <string name="model_switch_context">本对话上一条 AI 回复由模型 %1$s 生成；当前切换为 %2$s。请将已有对话作为连续上下文继续，不要重置或重复开始。</string>
</resources>
