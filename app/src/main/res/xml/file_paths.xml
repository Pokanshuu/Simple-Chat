<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 能对外暴露的路径。

    `cacheDir/captures` 是「拍照」的中转站：
    相机把照片写进来，我们读完转成 base64 落库，然后立刻删掉。
    `cacheDir/shares` 保存主动生成的分享文件，仅授予接收方临时读取权限。
    不暴露整个 cacheDir 或私有数据库。
-->
<paths>
    <cache-path name="captures" path="captures/" />
    <cache-path name="shares" path="shares/" />
</paths>
